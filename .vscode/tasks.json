{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Construct ADM64",
            "type": "shell",
            "command": "make",
            "args": [
                "BUILD=release",
                "ARCH=amd64"
            ],
            "group": {"kind":"build", "isDefault": true}
        },
        {
            "label": "Construct i386",
            "type": "shell",
            "command": "make",
            "args": [
                "BUILD=release",
                "ARCH=i386"
            ],
            "group": {"kind":"build"}
        },
        {
            "label": "Construct ARM64",
            "type": "shell",
            "command": "make",
            "args": [
                "BUILD=release",
                "ARCH=arm64"
            ],
            "group": {"kind":"build"}
        },
        {
            "label": "Construct ARMHF",
            "type": "shell",
            "command": "make",
            "args": [
                "BUILD=release",
                "ARCH=armhf"
            ],
            "group": {"kind":"build"}
        },
        {
            "label": "Compile (ASAN)",
            "type": "shell",
            "command": "make",
            "args": [
                "BUILD=debug",
                "INSPECTOR=asan",
                "ARCH=amd64"
            ],
            "problemMatcher": []
        },
        {
            "label": "Compile (VALGRIND)",
            "type": "shell",
            "command": "make",
            "args": [
                "BUILD=debug",
                "INSPECTOR=valgrind",
                "ARCH=amd64"
            ],
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "problemMatcher": []
        },
        {
            "label": "Run (ASAN)",
            "type": "shell",
            "command": "make",
            "args": [
                "runProject",
                "INSPECTOR=asan"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run (VALGRIND)",
            "type": "shell",
            "command": "make",
            "args": [
                "runProject",
                "INSPECTOR=valgrind"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Deployment",
            "type": "shell",
            "dependsOrder": "sequence",
            "dependsOn": ["Compile"],
            "command": "make",
            "args": [
                "runDeployment",
                "INSPECTOR=none"
            ],
            "problemMatcher": []
        },
        {
            "label": "Debug Project",
            "type": "shell",
            "dependsOrder": "sequence",
            "dependsOn": ["Compile (ASAN)"],
            "command": "make",
            "args": [
                "debugProject"
            ],
            "problemMatcher": []
        }
    ]
}